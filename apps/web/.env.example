# Rechel's Place environment template. Never commit the filled-in file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
DATABASE_URL=postgresql://user:password@host:5432/database
AUTH_SECRET=replace-with-at-least-32-random-characters

# Temporary owner account bootstrap. Keep disabled except during setup.
ADMIN_BOOTSTRAP_ENABLED=false
# Optional restriction. Leave blank so the owner can choose her email during setup.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_SECRET=replace-with-a-separate-at-least-32-character-setup-code

# Booking notifications (optional)
BOOKING_NOTIFICATION_EMAIL=

# Airbnb calendar sync (server-only)
AIRBNB_ICAL_URL=
AIRBNB_CALENDAR_TOKEN=replace-with-at-least-32-random-characters
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=replace-with-at-least-32-random-characters
