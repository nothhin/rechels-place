# Rechel's Place environment template. Never commit the filled-in file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=postgresql://user:password@host:5432/database
AUTH_SECRET=replace-with-at-least-32-random-characters

# Booking notifications (optional)
BOOKING_NOTIFICATION_EMAIL=

# Airbnb calendar sync (server-only)
AIRBNB_ICAL_URL=
AIRBNB_CALENDAR_TOKEN=replace-with-at-least-32-random-characters
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=replace-with-at-least-32-random-characters
